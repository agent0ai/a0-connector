Screen {
    background: #17181a;
    layers: base status;
}

#body-switcher {
    height: 1fr;
}

#context-tabs {
    height: 1;
    min-height: 1;
    margin-top: 1;
    margin-bottom: 0;
    padding: 0;
    background: transparent;
    color: #9aa7b4;
    overflow-x: hidden;
}

#context-tabs:focus {
    background: transparent;
}

#chat-log {
    height: 1fr;
    padding: 0;
    background: #17181a;
    overflow-x: hidden;
    scrollbar-size: 1 1;
}

#chat-log > TranscriptEntry {
    margin-top: 1;
    height: auto;
}

TranscriptEntry > SelectableStatic,
TranscriptEntry > StatusEntry,
TranscriptEntry > CodeEntry {
    height: auto;
}

.status-entry:focus {
    background: #1b232d;
}

.agent-zero-banner {
    margin-top: 0;
}

.workspace-context {
    margin-top: 1;
    color: #7f8c98;
}

#message-input {
    margin-top: 0;
    margin-bottom: 0;
    border: round #0f6db8;
    background: #101820;
    padding: 0 1;
}

/* Subtle highlight while progress placeholder is shown (see WebUI .progress-active). */
#message-input.progress-active {
    border: round #1886c9;
}

#message-input:focus {
    border: round #00b4ff;
}

#computer-use-banner {
    height: auto;
    min-height: 1;
    margin-top: 1;
    padding: 0 1;
    background: #f5c35a;
    color: #1b1d21;
    text-style: bold;
}

#model-switcher-bar {
    height: auto;
    min-height: 1;
    margin-top: 1;
    padding: 0 1;
    align: left middle;
    background: #101820;
}

#goal-bar.bar-following,
#model-switcher-bar.bar-following {
    margin-top: 0;
}

#goal-bar {
    height: auto;
    min-height: 2;
    margin-top: 1;
    padding: 0 1;
    background: #14212b;
}

#goal-bar-header {
    height: 1;
    layout: horizontal;
    align: left middle;
}

#goal-bar-summary {
    width: 1fr;
    height: 1;
}

#goal-bar-objective {
    height: 1;
    padding-left: 2;
    color: #929fac;
}

.goal-bar-action {
    width: auto;
    min-width: 8;
    height: 1;
    min-height: 1;
    margin-left: 1;
    padding: 0 1;
    background: transparent;
    border: none;
    color: #9aa7b4;
    content-align: center middle;
}

.goal-bar-action:focus {
    background: #172533;
    color: #d9e2ec;
    border: none;
}

#message-queue-bar {
    height: auto;
    max-height: 6;
    margin-top: 0;
    padding: 0 1;
    background: #101820;
    color: #c9d3dd;
    border-left: solid #0f6db8;
}

#model-switcher-summary {
    width: 1fr;
    height: auto;
    min-height: 1;
    layout: horizontal;
    align: left middle;
}

.model-switcher-chip {
    width: auto;
    min-width: 10;
    max-width: 100%;
    height: 1;
    min-height: 1;
    margin-right: 1;
    padding: 0 1;
    background: transparent;
    border: none;
    color: #9aa7b4;
    content-align: left middle;
    text-style: bold;
}

.model-switcher-chip:focus {
    background: #172533;
    color: #d9e2ec;
    border: none;
}

#model-switcher-preset {
    width: auto;
    min-width: 18;
    max-width: 34;
    margin-left: 2;
    background: transparent;
}

#model-switcher-preset > SelectCurrent {
    color: #9aa7b4;
    background: #101820;
}

#model-switcher-preset:focus > SelectCurrent {
    color: #d9e2ec;
}

Select > SelectOverlay {
    border: none;
    background: #101820;
    color: #d9e2ec;
    padding: 0;
}

Select > SelectOverlay:focus {
    border: none;
    background: #101820;
}

Select > SelectOverlay > .option-list--option {
    padding: 0 1;
}

Select > SelectOverlay > .option-list--option-highlighted,
Select > SelectOverlay:focus > .option-list--option-highlighted,
Select > SelectOverlay > .option-list--option-hover {
    background: #0f4d78;
    color: #f5f7fa;
    text-style: bold;
}

ModelPresetsScreen {
    align: left top;
    background: $background 60%;
}

ModelPresetsScreen > Center {
    align: left top;
}

#model-presets-box {
    width: 100%;
    max-width: 100%;
    height: auto;
    max-height: 18;
    border: none;
    background: #101820;
    padding: 0 1;
}

#model-presets-title {
    text-style: bold;
}

#model-presets-description {
    margin-bottom: 0;
    color: #9aa7b4;
}

#model-presets-select {
    width: 100%;
}

#model-presets-select > SelectCurrent {
    border: none;
    background: #101820;
    color: #d9e2ec;
    padding: 0 1;
}

#model-presets-select:focus > SelectCurrent {
    border: none;
    background: #0f4d78;
    color: #f5f7fa;
}

#model-presets-details {
    margin-top: 0;
    border: none;
    background: #101820;
    padding: 0 1;
    min-height: 3;
}

#model-presets-status {
    margin-top: 0;
    min-height: 1;
    color: #9aa7b4;
}

#model-presets-actions {
    margin-top: 1;
    align: right middle;
    height: auto;
}

#model-presets-actions Button {
    min-width: 12;
    margin-left: 1;
}

ModelRuntimeScreen {
    align: left top;
}

#model-runtime-box {
    width: 100%;
    height: 1fr;
    border: none;
    background: transparent;
    padding: 1 2;
    overflow-y: auto;
}

#model-runtime-title {
    text-style: bold;
}

#model-runtime-description {
    margin-bottom: 1;
    color: #9aa7b4;
}

.model-runtime-section {
    width: 100%;
    height: auto;
    border: none;
    background: transparent;
    padding: 0;
    margin-bottom: 1;
}

.model-runtime-section-title {
    text-style: bold;
    color: #d9e2ec;
    margin-top: 0;
}

.model-runtime-current {
    color: #7f8c98;
}

.model-runtime-label {
    margin-top: 1;
    color: #9aa7b4;
}

#model-runtime-box Input {
    width: 100%;
    background: #17181a;
    border: round #2a3a4a;
    color: #f5f7fa;
}

#model-runtime-box Input:focus {
    border: round #00b4ff;
}

#model-runtime-box Select {
    width: 100%;
}

#model-runtime-box Select > SelectCurrent {
    color: #d9e2ec;
    background: #17181a;
    border: round #2a3a4a;
}

#model-runtime-box Select:focus > SelectCurrent {
    border: round #00b4ff;
}

#model-runtime-status {
    margin-top: 1;
    min-height: 1;
    color: #9aa7b4;
}

#model-runtime-actions {
    margin-top: 1;
    align: right middle;
    height: auto;
}

#model-runtime-actions Button {
    min-width: 12;
    margin-left: 1;
}

CompactScreen {
    align: center middle;
}

#compact-box {
    width: 84%;
    max-width: 108;
    max-height: 94%;
    border: round #0f6db8;
    background: #101820;
    padding: 1 2;
    overflow-y: auto;
}

#compact-title {
    text-style: bold;
}

#compact-description {
    margin-bottom: 1;
    color: #9aa7b4;
}

#compact-metrics {
    height: 6;
    margin-bottom: 1;
}

.compact-metric-card {
    width: 1fr;
    border: round #2a3a4a;
    background: #111820;
    padding: 0 1;
    height: 6;
    min-height: 6;
    max-height: 6;
    content-align: center middle;
}

#compact-messages-card {
    margin-right: 1;
}

.compact-metric-label {
    color: #9aa7b4;
    text-style: bold;
    content-align: center middle;
    width: 100%;
}

.compact-metric-value {
    color: #e8f1fb;
    text-style: bold;
    content-align: center middle;
    width: 100%;
}

#compact-model-field {
    margin-top: 1;
    height: 5;
    width: 1fr;
    margin-right: 1;
}

#compact-model-label {
    color: #9aa7b4;
}

#compact-mode-toggle {
    margin-top: 1;
    height: auto;
}

#compact-mode-toggle Button {
    min-width: 12;
    margin-right: 1;
    background: #111820;
    color: #9aa7b4;
}

#compact-mode-toggle Button.is-active {
    background: #1b2f46;
    color: #d9e2ec;
    border: round #1886c9;
}

#compact-model-preview {
    margin-top: 1;
    color: #9aa7b4;
}

#compact-model-and-note {
    margin-top: 1;
    height: auto;
}

#compact-note-field {
    width: 1fr;
    height: auto;
}

#compact-note {
    border: round #2b6a42;
    background: #123324;
    color: #78d7a2;
    padding: 0 1;
    min-height: 3;
    height: auto;
    max-height: 6;
    overflow-y: auto;
    text-wrap: wrap;
    content-align: left top;
}

CompactScreen.compact-narrow #compact-model-and-note {
    layout: vertical;
}

CompactScreen.compact-narrow #compact-model-field {
    margin-right: 0;
    margin-bottom: 1;
}

CompactScreen.compact-narrow #compact-note {
    min-height: 3;
    height: auto;
    max-height: 5;
}

CompactScreen.compact-narrow #compact-note-field {
    height: auto;
}

/*
 * Legacy selector kept intentionally empty to avoid accidental style carryover
 * from older screenshots/branches.
 */
#compact-info {
    margin-top: 1;
    display: none;
}

#compact-stats {
    margin-top: 1;
    display: none;
}

#compact-status {
    margin-top: 1;
    min-height: 1;
    color: #9aa7b4;
}

#compact-actions {
    margin-top: 1;
    align: right middle;
    height: auto;
}

#compact-actions Button {
    min-width: 12;
    margin-left: 1;
}

#connection-status {
    layer: status;
    width: 100%;
    height: 1;
    layout: horizontal;
    align: right middle;
    padding: 0 2 0 0;
    background: transparent;
}

#connection-status-spacer {
    width: 1fr;
}

#connection-status-budget,
#connection-status-endpoint {
    height: 1;
    min-width: 0;
    background: transparent;
    color: #7f8c98;
    overflow-x: hidden;
    text-overflow: ellipsis;
}

#connection-status-budget {
    width: auto;
    margin-right: 2;
}

#connection-status-project {
    width: auto;
    min-width: 0;
    max-width: 36;
    height: 1;
    margin-right: 2;
    padding: 0 1;
    background: transparent;
    border: none;
    color: #d9e2ec;
    overflow-x: hidden;
    text-overflow: ellipsis;
}

#connection-status-project:hover {
    background: #172533;
}

#connection-status-endpoint {
    width: auto;
    max-width: 36;
}

Footer {
    background: #101820;
}

ChatListScreen {
    align: left top;
    background: $background 60%;
}

ChatListScreen > Center {
    align: left top;
}

#chat-list-box {
    width: 100%;
    max-width: 100%;
    height: auto;
    max-height: 18;
    border: none;
    background: #101820;
    padding: 0 1;
}

#chat-list-title {
    text-style: bold;
}

#chat-list-description {
    margin-bottom: 0;
    color: #7f8c98;
}

#chat-list-empty {
    color: #7f8c98;
    height: 3;
    content-align: center middle;
}

#chat-list {
    height: auto;
    max-height: 13;
    border: none;
    background: #101820;
    padding: 0;
}

#chat-list > ListItem {
    margin: 0;
    padding: 0;
    border-bottom: none;
}

#chat-list > ListItem.-highlight,
#chat-list > ListItem.-hovered {
    background: #0f4d78;
}

.chat-list-item-body {
    width: 100%;
    height: auto;
    padding: 0 1;
    background: transparent;
}

.chat-list-item-title {
    width: 100%;
    color: #d9e2ec;
    text-style: bold;
    overflow-x: hidden;
    text-overflow: ellipsis;
}

.chat-list-item-meta {
    width: 100%;
    color: #7f8c98;
    overflow-x: hidden;
    text-overflow: ellipsis;
}

.chat-list-item-preview {
    width: 100%;
    color: #b8c4cf;
    overflow-x: hidden;
    text-overflow: ellipsis;
}

#chat-list > ListItem.-highlight .chat-list-item-title {
    color: #f5f7fa;
}

#chat-list > ListItem.-highlight .chat-list-item-meta,
#chat-list > ListItem.-highlight .chat-list-item-preview {
    color: #9ecfff;
}

InstalledPluginsScreen {
    align: left top;
    background: $background 60%;
}

InstalledPluginsScreen > Center {
    align: left top;
}

#installed-plugins-box {
    width: 100%;
    max-width: 100%;
    height: auto;
    max-height: 20;
    border: none;
    background: #101820;
    padding: 0 1;
}

#installed-plugins-title {
    text-style: bold;
}

#installed-plugins-summary,
#installed-plugins-status,
#installed-plugins-help {
    color: #9aa7b4;
}

#installed-plugins-search {
    margin-top: 0;
    border: none;
    background: #101820;
    color: #d9e2ec;
    padding: 0 1;
}

#installed-plugins-search:focus {
    border: none;
    background: #101820;
}

#installed-plugins-list {
    height: auto;
    max-height: 12;
    margin-top: 0;
    border: none;
    background: #101820;
    padding: 0;
}

#installed-plugins-list > ListItem {
    margin: 0;
    padding: 0;
    border-bottom: none;
}

#installed-plugins-list > ListItem.-highlight,
#installed-plugins-list > ListItem.-hovered {
    background: #0f4d78;
}

.installed-plugin-row-line {
    width: 100%;
    height: 1;
    padding: 0 1;
    background: transparent;
}

.installed-plugin-marker {
    width: 4;
    color: #38c5d8;
    text-style: bold;
}

.installed-plugin-name {
    width: 3fr;
    min-width: 16;
    color: #d9e2ec;
    text-style: bold;
    overflow-x: hidden;
    text-overflow: ellipsis;
}

.installed-plugin-state {
    width: 10;
    color: #38c5d8;
    text-style: bold;
}

.installed-plugin-meta {
    width: 2fr;
    min-width: 14;
    color: #9aa7b4;
    overflow-x: hidden;
    text-overflow: ellipsis;
}

.installed-plugin-action {
    width: 18;
    color: #9ecfff;
    overflow-x: hidden;
    text-overflow: ellipsis;
}

.installed-plugin-description {
    width: 100%;
    padding: 0 1 1 5;
    color: #7f8c98;
    overflow-x: hidden;
    text-overflow: ellipsis;
}

#installed-plugins-list > ListItem.-highlight .installed-plugin-name {
    color: #f5f7fa;
}

#installed-plugins-list > ListItem.-highlight .installed-plugin-description,
#installed-plugins-list > ListItem.-highlight .installed-plugin-meta {
    color: #9ecfff;
}

#installed-plugins-empty {
    color: #7f8c98;
    height: 3;
    content-align: center middle;
}

#installed-plugins-status {
    min-height: 1;
}

#installed-plugins-help {
    color: #7f8c98;
}

#project-menu-popover {
    layer: status;
    overlay: screen;
    width: 38;
    height: auto;
    min-height: 0;
    max-height: 16;
    border: none;
    background: #101820;
    padding: 0 1;
}

.project-menu-item {
    width: 100%;
    height: 1;
    min-height: 1;
    margin: 0;
    padding: 0 1;
    background: transparent;
    border: none;
    color: #d9e2ec;
    content-align: left middle;
}

.project-menu-item:hover,
.project-menu-item:focus {
    background: #0f4d78;
    color: #f5f7fa;
}

.project-menu-item.-disabled {
    background: transparent;
    color: #7f8c98;
    opacity: 1;
}

.project-menu-section {
    height: 1;
    min-height: 1;
    margin-top: 1;
    color: #7f8c98;
}

#project-menu-items {
    height: auto;
    max-height: 8;
    margin-top: 0;
}

#project-menu-empty {
    color: #7f8c98;
    min-height: 3;
    content-align: center middle;
}

#profile-menu-popover {
    layer: status;
    overlay: screen;
    width: 44;
    height: auto;
    min-height: 0;
    max-height: 14;
    border: none;
    background: #101820;
    padding: 0 1;
}

#profile-menu-title {
    text-style: bold;
}

#profile-menu-current {
    color: #7f8c98;
    margin-bottom: 1;
}

.profile-menu-item {
    width: 100%;
    height: 1;
    min-height: 1;
    margin: 0;
    padding: 0 1;
    background: transparent;
    border: none;
    color: #d9e2ec;
    content-align: left middle;
}

.profile-menu-item:hover,
.profile-menu-item:focus {
    background: #0f4d78;
    color: #f5f7fa;
}

.profile-menu-item.-disabled {
    background: transparent;
    color: #7f8c98;
    opacity: 1;
}

.profile-menu-action {
    color: #80d0ff;
}

#profile-menu-items {
    height: auto;
    max-height: 9;
}

#profile-menu-empty {
    color: #7f8c98;
    min-height: 3;
    content-align: center middle;
}

ProfileEditorScreen {
    align: left top;
    background: $background 60%;
}

PermissionsScreen {
    align: left top;
    background: $background 60%;
}

PermissionsScreen > Center {
    align: left top;
}

#permissions-box {
    width: 100%;
    max-width: 100%;
    height: auto;
    max-height: 23;
    border: none;
    background: #101820;
    padding: 0 1;
}

#permissions-title {
    text-style: bold;
}

#permissions-profile,
#permissions-help {
    color: #9aa7b4;
}

#permissions-categories,
#permissions-actions {
    height: auto;
}

#permissions-categories Button {
    width: 1fr;
    min-width: 10;
    height: 2;
    border: none;
    border-bottom: solid #2a3a4a;
    background: transparent;
    color: #9aa7b4;
}

#permissions-categories Button:focus {
    background: #16212c;
    color: #d9e2ec;
}

#permissions-categories Button.is-active {
    border-bottom: solid #00b4ff;
    background: transparent;
    color: #e8f1fb;
    text-style: bold;
}

#permissions-default {
    width: 100%;
    height: 3;
    margin-top: 0;
    background: transparent;
    border: round #2a3a4a;
    color: #d9e2ec;
    text-align: left;
}

#permissions-default:focus {
    border: round #00b4ff;
}

#permissions-search {
    height: 1;
    min-height: 1;
    margin-top: 0;
    border: none;
    background: #101820;
    color: #d9e2ec;
    padding: 0 1;
}

#permissions-search:focus {
    border: none;
    background: #101820;
}

#permissions-list {
    height: auto;
    max-height: 11;
    border: none;
    background: #101820;
    padding: 0;
}

#permissions-list > ListItem {
    margin: 0;
    padding: 0;
    border-bottom: none;
}

#permissions-list > ListItem.-highlight,
#permissions-list > ListItem.-hovered {
    background: #0f4d78;
}

.permission-row-line {
    width: 100%;
    height: 1;
    padding: 0 1;
    background: transparent;
}

.permission-marker {
    width: 4;
    color: #38c5d8;
    text-style: bold;
}

.permission-name {
    width: 1fr;
    color: #d9e2ec;
    text-style: bold;
    overflow-x: hidden;
    text-overflow: ellipsis;
}

.permission-state {
    width: 16;
    color: #9ecfff;
    text-align: right;
}

.permission-state-allow {
    color: #5ee6a8;
}

.permission-state-block {
    color: #ff8b6b;
}

.permission-description {
    width: 100%;
    padding: 0 1 1 5;
    color: #7f8c98;
    overflow-x: hidden;
    text-overflow: ellipsis;
}

#permissions-empty {
    color: #7f8c98;
    height: 3;
    content-align: center middle;
}

#permissions-actions {
    align: right middle;
}

#permissions-actions Button {
    min-width: 10;
    margin-left: 1;
}

ProfileEditorScreen > Center {
    align: left top;
}

#profile-editor-box {
    width: 100%;
    max-width: 100%;
    height: 22;
    max-height: 100%;
    border: none;
    background: #101820;
    padding: 0 1;
}

#profile-editor-title {
    text-style: bold;
}

#profile-editor-step,
#profile-editor-tools-help {
    color: #9aa7b4;
}

#profile-editor-pages {
    height: 15;
}

.profile-editor-label {
    margin-top: 1;
    text-style: bold;
}

#profile-editor-name,
#profile-editor-instructions,
#profile-editor-tool-list {
    width: 100%;
    background: #17181a;
    border: round #2a3a4a;
}

#profile-editor-name:focus,
#profile-editor-instructions:focus,
#profile-editor-tool-list:focus {
    border: round #00b4ff;
}

#profile-editor-instructions {
    height: 9;
}

#profile-editor-tool-list {
    height: 1fr;
    margin-top: 1;
}

#profile-editor-status {
    min-height: 1;
}

#profile-editor-actions {
    height: auto;
    align: right middle;
}

#profile-editor-actions Button {
    min-width: 10;
    margin-left: 1;
}

ProjectInstructionsScreen {
    align: left top;
}

#project-instructions-box {
    width: 100%;
    height: 1fr;
    padding: 1 2;
    background: transparent;
}

#project-instructions-title {
    text-style: bold;
}

#project-instructions-subtitle {
    margin-top: 0;
    color: #7f8c98;
}

#project-instructions-description {
    margin-top: 1;
    color: #9aa7b4;
}

#project-instructions-input {
    width: 100%;
    height: 1fr;
    margin-top: 1;
    background: #17181a;
    border: round #2a3a4a;
}

#project-instructions-input:focus {
    border: round #00b4ff;
}

#project-instructions-actions {
    margin-top: 1;
    align: right middle;
    height: auto;
}

#project-instructions-actions Button {
    min-width: 12;
    margin-left: 1;
}

/* -------------------------------------------------------------------------- */
/* Splash / welcome surface                                                   */
/* -------------------------------------------------------------------------- */

SplashView {
    height: 1fr;
    padding: 1;
    background: #17181a;
}

#splash-hero {
    margin-bottom: 0;
}

#splash-workspace {
    margin-top: 1;
    color: #7f8c98;
}

#splash-stage-label {
    margin-top: 1;
    text-style: bold;
    color: #00b4ff;
}

#splash-message {
    text-style: bold;
    margin-top: 0;
}

#splash-detail {
    color: #9aa7b4;
    margin-bottom: 0;
}

SplashView.stage-host #splash-stage-label {
    color: #88bfff;
}

SplashView.stage-login #splash-stage-label {
    color: #80d0ff;
}

SplashView.stage-connecting #splash-stage-label {
    color: #f5c35a;
}

SplashView.stage-ready #splash-stage-label {
    color: #79d18a;
}

SplashView.stage-error #splash-stage-label {
    color: #ff8b6b;
}

SplashHostPanel,
SplashLoginPanel,
SplashStatusPanel {
    width: 100%;
    height: auto;
    min-height: 0;
    border: none;
    background: transparent;
    padding: 1 2;
    margin-top: 1;
}

.splash-panel-title {
    text-style: bold;
    margin-bottom: 1;
}

.splash-panel-copy,
.splash-panel-hint,
.splash-action-description,
.splash-action-reason {
    color: #9aa7b4;
}

.splash-panel-hint,
.splash-action-reason {
    margin-top: 1;
}

#splash-login-target-summary {
    margin-top: 1;
}

#splash-login-target-url {
    width: 1fr;
    color: #9aa7b4;
}

#splash-login-target-row {
    width: 100%;
    height: auto;
    min-height: 1;
    margin-top: 0;
    layout: horizontal;
    align: left middle;
}

#splash-host-loading,
#splash-host-status,
#splash-host-list-mount {
    margin-top: 1;
}

#splash-host-status {
    color: #9aa7b4;
}

#splash-host-list-mount {
    width: 100%;
    border: round #2a3a4a;
    background: #111820;
    padding: 0 1;
    overflow-y: auto;
}

.splash-host-row {
    width: 100%;
    height: 4;
    min-height: 4;
    margin: 0;
    padding: 0;
    border-bottom: solid #1d2a36;
    overflow: hidden;
}

.splash-host-row.-highlight,
.splash-host-row:hover {
    background: #172533;
}

.splash-host-row-body {
    width: 100%;
    height: 4;
    min-height: 4;
    padding: 1 1 0 1;
    background: transparent;
    overflow: hidden;
}

.splash-host-row-title {
    width: 100%;
    color: #d9e2ec;
    text-style: bold;
    overflow-x: hidden;
    text-overflow: ellipsis;
}

.splash-host-row-meta {
    width: 100%;
    margin-bottom: 1;
    color: #7f8c98;
    overflow-x: hidden;
    text-overflow: ellipsis;
}

.splash-host-row.-highlight .splash-host-row-title,
.splash-host-row:focus .splash-host-row-title {
    color: #f5f7fa;
}

.splash-host-row.-highlight .splash-host-row-meta,
.splash-host-row:focus .splash-host-row-meta {
    color: #9ecfff;
}

#splash-host-validation {
    margin-top: 1;
    min-height: 1;
}

#splash-host-secondary-actions {
    width: 100%;
    height: auto;
    layout: horizontal;
    margin-top: 1;
}

#splash-host-refresh,
#splash-host-toggle-manual {
    width: 1fr;
    background: transparent;
    color: #80d0ff;
    border: round #2a3a4a;
    text-style: bold;
}

#splash-host-refresh {
    margin-right: 1;
}

#splash-host-refresh:focus,
#splash-host-toggle-manual:focus {
    background: #172533;
    color: #f5f7fa;
    border: round #00b4ff;
}

#splash-host-refresh:disabled,
#splash-host-toggle-manual:disabled {
    color: #7f8b97;
    border: round #2a3a4a;
}

#splash-login-back {
    width: auto;
    height: auto;
    margin-top: 0;
    min-width: 14;
    margin-left: 1;
    background: transparent;
    color: #80d0ff;
    border: none;
    text-style: bold;
}

#splash-login-back:focus {
    background: #172533;
    color: #f5f7fa;
    border: round #00b4ff;
}

#splash-status-actions {
    width: 100%;
    height: auto;
    layout: horizontal;
    margin-top: 1;
}

#splash-status-back {
    width: 16;
    height: auto;
    margin-top: 0;
    margin-right: 1;
    background: transparent;
    color: #80d0ff;
    border: round #2a3a4a;
    text-style: bold;
}

#splash-status-back:focus {
    background: #172533;
    color: #f5f7fa;
    border: round #00b4ff;
}

#splash-status-back:disabled {
    color: #7f8b97;
    border: round #2a3a4a;
}

#splash-host-input,
#splash-login-username,
#splash-login-password {
    width: 100%;
    margin-top: 1;
    background: #17181a;
    border: round #2a3a4a;
    color: #f5f7fa;
}

#splash-host-input:focus,
#splash-login-username:focus,
#splash-login-password:focus {
    border: round #00b4ff;
}

#splash-host-submit,
#splash-login-submit,
#splash-status-retry {
    width: 100%;
    margin-top: 1;
    background: #0f6db8;
    color: #f5f7fa;
    border: round #0f6db8;
    text-style: bold;
}

#splash-host-submit:focus,
#splash-login-submit:focus,
#splash-status-retry:focus {
    background: #00b4ff;
    color: #08131d;
    border: round #8ad7ff;
}

#splash-host-submit:disabled,
#splash-login-submit:disabled,
#splash-status-retry:disabled {
    background: #1c2732;
    color: #7f8b97;
    border: round #2a3a4a;
}

#splash-status-retry {
    width: 1fr;
    margin-top: 0;
}

#splash-manual-section {
    width: 100%;
    height: auto;
    margin-top: 1;
    padding-top: 1;
    border-top: solid #1d2a36;
}

#splash-manual-title {
    margin-bottom: 0;
}

#splash-save-credentials {
    margin-top: 1;
    padding: 0 1;
    color: #c7d2dd;
}

#splash-save-credentials:focus {
    background: #172533;
    color: #f5f7fa;
    border: round #00b4ff;
}

#splash-status-spinner {
    margin-bottom: 1;
}

#splash-status-title {
    text-style: bold;
}

#splash-status-detail {
    color: #9aa7b4;
    margin-top: 1;
}

#splash-actions-grid {
    margin-top: 1;
    layout: grid;
    grid-size: 2;
    grid-gutter: 1 1;
}

.splash-action-card {
    border: round #2a3a4a;
    background: #111820;
    padding: 1;
    min-height: 6;
}

.splash-action-card Button {
    width: 100%;
}

.splash-action-card Button:disabled {
    color: #7f8b97;
}

.splash-action-card .splash-action-description {
    margin-top: 1;
}

.splash-action-card .splash-action-reason {
    color: #f0b54d;
}

ImageEntry {
    height: auto;
    margin-top: 1;
    padding: 0 0 0 4;
}

ImageEntry:focus {
    background: #1b232d;
}

.image-caption,
.image-placeholder {
    height: auto;
    color: #9aa7b4;
}

.image-surface-host {
    width: auto;
    height: auto;
}
